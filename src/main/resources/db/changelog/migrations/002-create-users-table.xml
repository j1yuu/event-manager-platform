<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-users-table" author="kkashin">

        <createTable tableName="users">
            <column
                    name="id"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_users"
                        nullable="false"/>
            </column>

            <column name="login" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="login_normalized" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="age" type="INTEGER"/>

            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column
                    name="updated_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="users"
                columnNames="login_normalized"
                constraintName="uk_users_username"/>

        <sql>
            ALTER TABLE users
                ADD CONSTRAINT chk_users_age_non_negative
                    CHECK (age IS NULL OR age &gt;= 0);
        </sql>

        <rollback>
            <dropTable tableName="users"/>
        </rollback>

    </changeSet>

</databaseChangeLog>